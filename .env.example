# Kiwoom API Keys — separated by environment to prevent error 8030
# (8030: investment type mismatch — mock key rejected by real server, and vice versa)
#
# Mock/simulated trading keys (mockapi.kiwoom.com):
KIWOOM_MOCK_APP_KEY=
KIWOOM_MOCK_SECRET_KEY=
#
# Real/production trading keys (api.kiwoom.com):
# Required when KIWOOM_ENV=real or KIWOOM_ENV=prod
KIWOOM_REAL_APP_KEY=
KIWOOM_REAL_SECRET_KEY=
#
# Legacy fallback (mock env only): used if KIWOOM_MOCK_APP_KEY is not set
KIWOOM_APP_KEY=
KIWOOM_APP_SECRET=
KIWOOM_SECRET_KEY=

# Environment selection: mock | real | prod (prod is alias for real)
KIWOOM_ENV=mock

INTRADAY_PROVIDER=mock
INTRADAY_BOARD_ENABLED=false
INTRADAY_POLL_SECONDS=60
INTRADAY_MAX_CODES=300
INTRADAY_EVIDENCE_ENABLED=false
INTRADAY_EVIDENCE_LIMIT=10
UNIVERSE_MIN_MARKET_CAP=500000000000
UNIVERSE_MIN_TRADE_VALUE=0
UNIVERSE_EXCLUDE_ETF=true
UNIVERSE_EXCLUDE_SPAC=true
UNIVERSE_EXCLUDE_PREFERRED=true
UNIVERSE_EXCLUDE_MANAGED=true
KIWOOM_BASE_URL=
KIWOOM_ACCOUNT_NO=
USE_DUMMY_DATA=true
KIWOOM_USE_MOCK=true
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
OPENDART_API_KEY=
OPENAI_API_KEY=
